# Tasks 2–4 read these values from the process environment; .env is not auto-loaded.
# Bind demo services to loopback. Task 1 needs no configuration.
# This file contains no working credentials. Never put real secrets here.

QUILR_MCP_DOWNSTREAM_URL=http://127.0.0.1:9000/mcp
QUILR_MCP_TIMEOUT_SECONDS=5

# Supply distinct opaque local tokens before running Task 2.
# Missing, blank, identical or malformed credentials prevent gateway startup.
QUILR_ADMIN_TOKEN=
QUILR_VIEWER_TOKEN=

# Task 3 uses a separate local mock provider. No API key is required.
QUILR_LLM_STREAM_URL=http://127.0.0.1:9001/stream
QUILR_LLM_TIMEOUT_SECONDS=10

# Task 4 routes to two local mock providers and persists quota to on-disk SQLite.
QUILR_PRIMARY_MODEL_URL=http://127.0.0.1:9002/primary/completions
QUILR_SECONDARY_MODEL_URL=http://127.0.0.1:9002/secondary/completions
QUILR_RATE_LIMIT_DB_PATH=./var/rate_limit.sqlite3
QUILR_RATE_LIMIT_TOKENS=50000
QUILR_RATE_LIMIT_WINDOW_SECONDS=60

# The assessment fixes the primary deadline at 3000 ms; both are overridable for tests.
QUILR_PRIMARY_TIMEOUT_SECONDS=3
QUILR_SECONDARY_TIMEOUT_SECONDS=3

# Optional. Comma-separated demo tenant keys; when set, only these keys are metered.
# Leaving it blank accepts any well-formed bearer key as a distinct tenant identity.
QUILR_TENANT_API_KEYS=

# Optional pepper for the stored tenant fingerprint. Blank uses an unkeyed digest,
# which is weaker against offline guessing of low-entropy keys.
QUILR_TENANT_FINGERPRINT_KEY=
